# Configure real values only in the server environment. Never commit credentials.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_PROXY_URL=
LLM_READ_TIMEOUT_SECONDS=120

# Persistent single-replica Railway Volume. Local paths may be relative.
DATA_ROOT=/data
OKF_DATA_ROOT=/data/okf
SIMULATOR_ROOT=/data/simulator
SESSION_ROOT=/data/sessions
TOOL_REGISTRY_ROOT=/data/tools
OFFER_TTL_SECONDS=900
PORT=2024

# Future demo form: server-to-server lookup of the creditor configured in Canais.
# Keep the token only in the backend service; never expose it as a browser variable.
CHANNEL_CONSOLE_URL=
CHANNEL_CONSOLE_ENGINE_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional, separately configured chat connections. Blank = unavailable in UI.
# Lovable should point to the dedicated authenticated bridge, not playground-chat.
LLM_LOVABLE_BASE_URL=
LLM_LOVABLE_MODEL=
LLM_LOVABLE_API_KEY=
LLM_LOVABLE_PROXY_URL=
LLM_LOVABLE_READ_TIMEOUT_SECONDS=120
LLM_EXTERNAL_BASE_URL=
LLM_EXTERNAL_MODEL=
LLM_EXTERNAL_API_KEY=
LLM_EXTERNAL_PROXY_URL=
LLM_EXTERNAL_READ_TIMEOUT_SECONDS=120
